@page "/price-history"
@rendermode InteractiveServer
@using CheckScanner.Application.Dtos
@inject CheckScanner.Application.Services.PriceHistoryService PriceHistoryService

<PageTitle>Item Price History</PageTitle>

<div class="mx-auto flex w-full max-w-md flex-1 flex-col gap-4 px-4 py-6 sm:px-6">
    <h1 class="text-lg font-semibold text-slate-900">Item Price History</h1>

    @if (_productNames is null)
    {
        <p class="text-sm text-slate-500">Loading…</p>
    }
    else if (_productNames.Count == 0)
    {
        <p class="text-sm text-slate-500">No products yet — upload a receipt first.</p>
    }
    else
    {
        <div class="flex flex-col gap-2">
            <input
                type="search"
                placeholder="Search for a product…"
                value="@_searchTerm"
                @oninput="OnSearchInput"
                class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none" />

            @if (_selectedProduct is null)
            {
                var filtered = FilteredProductNames;
                <ul class="flex max-h-64 flex-col gap-1 overflow-y-auto">
                    @foreach (var name in filtered)
                    {
                        <li>
                            <button
                                type="button"
                                @onclick="() => SelectProductAsync(name)"
                                class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-left text-sm text-slate-900 hover:bg-slate-50">
                                @name
                            </button>
                        </li>
                    }
                    @if (filtered.Count == 0)
                    {
                        <li class="px-3 py-2 text-sm text-slate-500">No matching products.</li>
                    }
                </ul>
            }
        </div>

        @if (_selectedProduct is not null)
        {
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-medium text-slate-900">@_selectedProduct</h2>
                <button type="button" @onclick="ClearSelection" class="text-sm text-slate-500 underline">Change product</button>
            </div>

            @if (_points is null)
            {
                <p class="text-sm text-slate-500">Loading…</p>
            }
            else if (_points.Count == 0)
            {
                <p class="text-sm text-slate-500">No dated purchases found for this product.</p>
            }
            else if (_chart is not null)
            {
                <div class="rounded-lg border border-slate-200 bg-white p-3">
                    <svg
                        viewBox="0 0 @PriceHistoryChartBuilder.Width @PriceHistoryChartBuilder.Height"
                        class="w-full" preserveAspectRatio="xMidYMid meet">
                        @foreach (var series in _chart.Series)
                        {
                            <polyline points="@series.PolylinePoints" fill="none" stroke="@series.Color" stroke-width="2" />
                            @foreach (var point in series.Points)
                            {
                                <circle cx="@point.X.ToString("F1")" cy="@point.Y.ToString("F1")" r="2.5" fill="@series.Color" />
                            }
                        }
                    </svg>
                    <div class="mt-1 flex justify-between text-[11px] text-slate-400">
                        <span>@_chart.MinDateLabel</span>
                        <span>@_chart.MaxDateLabel</span>
                    </div>
                    <div class="mt-1 flex justify-between text-[11px] text-slate-400">
                        <span>@_chart.MinPriceLabel</span>
                        <span>@_chart.MaxPriceLabel</span>
                    </div>
                </div>

                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    @foreach (var series in _chart.Series)
                    {
                        <li class="flex items-center gap-1.5 text-xs text-slate-600">
                            <span class="h-2 w-2 rounded-full" style="background-color: @series.Color"></span>
                            @series.StoreName
                        </li>
                    }
                </ul>
            }
        }
    }
</div>

@code {
    private IReadOnlyList<string>? _productNames;
    private string _searchTerm = "";
    private string? _selectedProduct;
    private IReadOnlyList<PriceHistoryPointDto>? _points;
    private PriceHistoryChartBuilder.ChartResult? _chart;

    private IReadOnlyList<string> FilteredProductNames =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _productNames ?? []
            : (_productNames ?? []).Where(n => n.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        _productNames = await PriceHistoryService.GetProductNamesAsync(CancellationToken.None);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
    }

    private async Task SelectProductAsync(string productName)
    {
        _selectedProduct = productName;
        _points = await PriceHistoryService.GetPriceHistoryAsync(productName, CancellationToken.None);
        _chart = _points.Count > 0 ? PriceHistoryChartBuilder.Build(_points) : null;
    }

    private void ClearSelection()
    {
        _selectedProduct = null;
        _points = null;
        _chart = null;
        _searchTerm = "";
    }
}
