@page "/"
@rendermode InteractiveServer
@inject CheckScanner.Application.Services.ReceiptUploadService UploadService
@inject NavigationManager Nav

<PageTitle>Upload Receipt</PageTitle>

<div class="mx-auto flex w-full max-w-4xl flex-1 flex-col gap-4 px-4 py-6 sm:px-6">
    <h1 class="text-lg font-semibold text-slate-900">Upload a receipt</h1>

    <div x-data="{ previews: [] }" class="flex flex-col gap-4">
        <label class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 bg-white px-4 py-10 text-center text-sm text-slate-500 hover:border-slate-400">
            <span>Tap to take a photo or choose from your library</span>
            <InputFile
                OnChange="OnFilesSelected"
                multiple
                capture="environment"
                accept="image/*"
                class="hidden"
                x-on:change="previews = []; Array.from($event.target.files).forEach(f => { const r = new FileReader(); r.onload = () => previews = [...previews, r.result]; r.readAsDataURL(f); })" />
        </label>

        <div class="grid grid-cols-2 gap-2" x-show="previews.length > 0" x-cloak>
            <template x-for="(src, index) in previews" :key="index">
                <img :src="src" class="h-32 w-full rounded-lg object-cover" />
            </template>
        </div>
    </div>

    @if (_error is not null)
    {
        <p class="text-sm text-red-600">@_error</p>
    }

    <button
        type="button"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white disabled:opacity-50"
        disabled="@(_selectedFiles.Count == 0 || _isUploading)"
        @onclick="SubmitAsync">
        @(_isUploading ? "Uploading…" : $"Upload {_selectedFiles.Count} photo(s)")
    </button>
</div>

@code {
    private const int MaxFileSizeBytes = 10 * 1024 * 1024;
    private const int MaxFileCount = 10;

    private IReadOnlyList<IBrowserFile> _selectedFiles = [];
    private bool _isUploading;
    private string? _error;

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _selectedFiles = e.GetMultipleFiles(MaxFileCount);
        _error = null;
    }

    private async Task SubmitAsync()
    {
        if (_selectedFiles.Count == 0)
        {
            return;
        }

        _isUploading = true;
        _error = null;

        var streams = new List<(string FileName, Stream Content)>();
        try
        {
            foreach (var file in _selectedFiles)
            {
                streams.Add((file.Name, file.OpenReadStream(MaxFileSizeBytes)));
            }

            await UploadService.UploadAsync(streams, CancellationToken.None);
            Nav.NavigateTo("/receipts");
        }
        catch (Exception ex)
        {
            _error = $"Upload failed: {ex.Message}";
        }
        finally
        {
            foreach (var (_, stream) in streams)
            {
                await stream.DisposeAsync();
            }
            _isUploading = false;
        }
    }
}
