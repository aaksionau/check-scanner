@page "/needs-review"
@rendermode InteractiveServer
@inject CheckScanner.Application.Services.ReceiptReviewService ReviewService

<PageTitle>Needs Review</PageTitle>

<div class="mx-auto flex w-full max-w-md flex-1 flex-col gap-4 px-4 py-6 sm:px-6">
    <h1 class="text-lg font-semibold text-slate-900">Needs Review</h1>

    @if (_receipts is null)
    {
        <p class="text-sm text-slate-500">Loading…</p>
    }
    else if (_receipts.Count == 0)
    {
        <p class="text-sm text-slate-500">Nothing to review — every receipt reconciled.</p>
    }
    else
    {
        <ul class="flex flex-col gap-2">
            @foreach (var receipt in _receipts)
            {
                <li>
                    <a href="/receipts/@receipt.Id" class="flex items-center justify-between rounded-lg border border-amber-200 bg-amber-50 px-4 py-3">
                        <div>
                            <p class="text-sm font-medium text-slate-900">@(receipt.StoreName ?? "Unknown store")</p>
                            <p class="text-xs text-slate-500">@(receipt.PurchasedAt?.ToString("MMM d, yyyy") ?? "Date pending")</p>
                        </div>
                        <p class="text-sm font-semibold text-amber-800">
                            @(receipt.MismatchAmount is { } mismatch ? $"Off by {mismatch:C}" : "No printed total")
                        </p>
                    </a>
                </li>
            }
        </ul>
    }
</div>

@code {
    private IReadOnlyList<CheckScanner.Application.Dtos.FlaggedReceiptDto>? _receipts;

    protected override async Task OnInitializedAsync()
    {
        _receipts = await ReviewService.GetFlaggedAsync(CancellationToken.None);
    }
}
